# ---------- Banco ----------
# PostgreSQL 16 e suportado pelo Zabbix 6.0 (patches recentes), 7.0 e 8.0,
# assim nao precisa trocar a major do Postgres durante o lab.
POSTGRES_TAG=16-alpine
POSTGRES_USER=zabbix
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=zabbix

# ---------- Zabbix (ponto de partida: 6.0 LTS) ----------
ZBX_SERVER_TAG=alpine-6.0-latest
ZBX_WEB_TAG=alpine-6.0-latest
ZBX_PROXY_ACTIVE_TAG=alpine-6.0-latest
ZBX_PROXY_PASSIVE_TAG=alpine-6.0-latest
ZBX_AGENT_TAG=alpine-6.0-latest

PHP_TZ=America/Sao_Paulo
